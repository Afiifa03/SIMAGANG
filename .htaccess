RewriteEngine On
RewriteBase /SIMAGANG/

# Hapus index.php dari URL jika ada
RewriteCond %{THE_REQUEST} \s/index\.php[^\s]* [NC]
RewriteRule ^index\.php/?(.*)$ /SIMAGANG/$1 [R=301,L]

# Lewati file dan folder yang benar-benar ada (css, js, img, dll)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Arahkan semua permintaan lainnya ke index.php?page=nama
RewriteRule ^([^/]+)/?$ index.php?page=$1 [QSA,L]
